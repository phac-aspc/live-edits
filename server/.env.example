NODE_ENV=production
HOST=127.0.0.1
PORT=3000
PUBLIC_BASE_URL=https://test.infobase-dev.com/live-edits
API_PATH=/api/v1
WS_PATH=/socket.io
DB_PATH=E:/live-edits/server/data/live-edits-v4.db
CORS_ORIGINS=https://en.infobase-dev.com,https://fr.infobase-dev.com
TRUST_PROXY=loopback
AUTH_MODE=token
# Network mode trusts the VPN/network boundary and requires reviewers to supply
# a self-reported name and email. Use "token" to retain the shared editor code.
EDITOR_AUTH_MODE=network
# EDITOR_TOKEN=replace-with-a-long-random-editor-token
ADMIN_TOKEN=replace-with-a-different-long-random-admin-token
MAX_EDIT_BYTES=10485760
HISTORY_LIMIT=25
