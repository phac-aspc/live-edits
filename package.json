{
  "name": "health-infobase-live-edits",
  "version": "4.0.0",
  "description": "Authenticated collaborative content review and safe publishing for Health Infobase products",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.18.1 <25"
  },
  "scripts": {
    "setup": "node scripts/setup-product.js",
    "publish": "node scripts/publish-product.js",
    "test": "node --test tests/*.test.js",
    "check": "node scripts/check-project.js",
    "server": "npm --prefix server start",
    "server:dev": "npm --prefix server run dev"
  },
  "keywords": [
    "wysiwyg",
    "editor",
    "collaboration",
    "health-infobase"
  ],
  "author": "Health Infobase",
  "license": "MIT",
  "dependencies": {
    "parse5": "8.0.1",
    "sanitize-html": "2.17.7"
  }
}
