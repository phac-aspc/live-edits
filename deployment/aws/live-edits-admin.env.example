# Store the real file at /etc/live-edits/admin.env with owner root and mode 0600.
# Generate two different values, for example: openssl rand -base64 48
LIVE_EDITS_ADMIN_UI_TOKEN=replace-with-a-separate-admin-console-passphrase
LIVE_EDITS_ADMIN_TOKEN=replace-with-the-existing-azure-admin-token

LIVE_EDITS_ADMIN_ORIGIN=https://en.infobase-dev.com
LIVE_EDITS_ADMIN_HOST=127.0.0.1
LIVE_EDITS_ADMIN_PORT=3100
LIVE_EDITS_ADMIN_COOKIE_PATH=/_live-edits/v4/admin/
LIVE_EDITS_ADMIN_SESSION_MINUTES=60
LIVE_EDITS_API_BASE=https://test.infobase-dev.com/live-edits
LIVE_EDITS_STATE_DIR=/home/ec2-user/environment/tools/live-edits/state
LIVE_EDITS_EN_ROOT=/home/ec2-user/environment/wwwroot/en
LIVE_EDITS_FR_ROOT=/home/ec2-user/environment/wwwroot/fr
LIVE_EDITS_STAGING_ROOT=/home/ec2-user/environment/wwwroot/_live-edits/v4
